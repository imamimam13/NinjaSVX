PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# SvxLink Paths
SVXLINK_CONF=/etc/svxlink/svxlink.conf
MODULE_ECHOLINK_CONF=/etc/svxlink/svxlink.d/ModuleEchoLink.conf
SVXLINK_LOG=/var/log/svxlink

# PTY control paths (configured in svxlink.conf under [Rx1] and Logic)
DTMF_PTY=/tmp/svxlink_dtmf_pty
STATE_PTY=/tmp/svxlink_state_pty

# Node Identity Defaults
DEFAULT_CALLSIGN=NINJA-NODE
DEFAULT_TG=91

# Force simulation mode (true/false) - Auto-detects if files are missing
SIMULATION_MODE=auto
